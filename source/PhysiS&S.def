Bootstrap: docker
From: ubuntu:22.04

%files

%post

    ln -fs /usr/share/zoneinfo/Europe/Rome /etc/localtime
    export DEBIAN_FRONTEND=noninteractive
    echo "export DEBIAN_FRONTEND=noninteractive" >> $SINGULARITY_ENVIRONMENT

    apt update -y
    apt upgrade -y

    apt install python3.10 -y
    apt install python3-pip -y
    apt install python-is-python3 -y
    apt install python3-venv -y
    apt install vim -y
    apt install git -y

    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118
    pip install --no-cache-dir numpy==1.26.4
    pip install --no-cache-dir matplotlib==3.8.2
    pip install --no-cache-dir pandas==2.2.0
    pip install --no-cache-dir PyYAML==6.0.1
    pip install --no-cache-dir scipy==1.12.0
    pip install --no-cache-dir pctk==0.2.2

%runscript
    #!/bin/bash
    if [ -z "$1" ]; then
        echo "Error: output folder missing"
        echo "usage: singularity run container.sif /path/to/your/output/folder"
        exit 1
    fi
    output_folder=$(realpath "$1")

    cd ../test
    
    # run the utility test for the first use case
    python utility_test.py "$output_folder" 

    # run the quantitative test for the first use case
    python quantitative_test.py "$output_folder"

    # run the utility test for the second use case
    python utility_test_second.py "$output_folder" 

    # run the quantitative test for the first use case
    python quantitative_test_second.py "$output_folder"

    # run the time plot
    cd ../helpers/plots
    python time_plot.py "$output_folder/quantitative_test.json" "$output_folder/quantitative_test_second.json" "$output_folder"

